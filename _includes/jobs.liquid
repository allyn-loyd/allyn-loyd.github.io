{% if site.experiences %}
  <div class="jobs">
    <div class="experience-list">
    {% assign jobs = site.experiences | sort: 'year' | reverse %}
    {% for job in jobs %}
        <div class="job-item">
        <h4 class="company-title">
            <a href="{{ job.website }}" target="_blank" rel="noopener noreferrer">
                {{ job.company }}
            </a>
        </h4>
        <h5 class="job-title">
            {{ job.title }}
        </h5>

        <div class="job-meta">
            {% if job.term %}
            <span class="job-term">{{ job.term }}</span>
            {% endif %}
            
            {% if job.location %}
            <span class="job-location">{{ job.location}}</span>
            {% endif %}
        </div>

        <div class="job-description">
            <ul>
            {% for item in job.description %}
                <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
            {% endfor %}
            </ul>
        </div>
        </div>
    {% endfor %}
    </div>
{% else %}
  <p>No experience available.</p>
{% endif %}
